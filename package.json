{
  "name": "@loonfs/just-bash",
  "version": "0.0.2",
  "description": "Sandboxed workspace shell for durable, revisioned LoonFS namespaces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loonfs/loonfs-just-bash.git"
  },
  "bugs": {
    "url": "https://github.com/loonfs/loonfs-just-bash/issues"
  },
  "homepage": "https://github.com/loonfs/loonfs-just-bash#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "example": "npm run build && node examples/design-partner.mjs",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release-install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "lint": "eslint ."
  },
  "dependencies": {
    "just-bash": "3.4.2"
  },
  "peerDependencies": {
    "@loonfs/sdk": "^0.1.3"
  },
  "devDependencies": {
    "@loonfs/sdk": "git+https://github.com/loonfs/loonfs-sdk-typescript.git#8a925ba3ca87a81ad9e7077b16e79b8d850a6103",
    "@types/node": "^26.4.0",
    "ai": "6.0.272",
    "bash-tool": "1.3.19",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
